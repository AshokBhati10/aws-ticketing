# Copy to .env and fill in the values from your CloudFormation stack outputs.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_DOMAIN=https://<your-domain-prefix>.auth.<region>.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<cognito-app-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_LOGOUT_URI=http://localhost:5173
VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com
